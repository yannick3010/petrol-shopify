{% liquid
	if section.settings.layout == 'bar'
		if section.settings.position != 'bottom' and section.settings.position != 'top'
			assign width = section.settings.width | append: 'px'
		else
			assign width = '100%'
		endif
	else
		assign width = section.settings.width | append: 'px'
	endif
%}

<div
	class="
		popup-main popup
		popup--{{ section.settings.position }}
		popup-main-image--{{ section.settings.image_layout }}
		{% if section.settings.full-height %}popup-full-height{% endif %}
	"
	{% if section.settings['popup-id'] != blank %}
		id="{{ section.settings.popup-id }}"
	{% endif %}
	data-limit-display="{{ section.settings.limit-display }}"
	data-limit-lifetime="{{ section.settings.limit-cache }}"
	data-open-trigger="{{ section.settings.trigger-open }}"
	data-open-delay-number="{{ section.settings.trigger-open-delay }}"
	data-open-scroll-position="{{ section.settings.open-scroll-position }}"
	data-open-scroll-type="{{ section.settings.open-scroll-type }}"
	{% if section.settings['manual-selector'] != blank %}
		data-open-manual-selector="{{ section.settings.manual-selector }}"
	{% endif %}
	data-close-trigger="{{ section.settings.trigger-close }}"
	data-close-delay-number="{{ section.settings.trigger-close-delay }}"
	data-close-scroll-position="{{ section.settings.close-scroll-position }}"
	data-close-scroll-type="{{ section.settings.close-scroll-type }}"
	data-open-animation="popupOpen{{ section.settings.open-animation }}"
	data-exit-animation="popupExit{{ section.settings.exit-animation }}"
	data-overlay="{{ section.settings.show-overlay }}"
	data-mobile-disable="{{ section.settings.mobile }}"
	data-body-scroll-disable="{{ section.settings.scrolling }}"
	data-overlay-close="{{ section.settings.overlay-close }}"
	data-esc-close="{{ section.settings.esc-close }}"
	data-f4-close="{{ section.settings.f4-close }}"
	data-id="{{ section.id }}"
	style="width: {{ width }}"
>
	{%- style -%}
		#shopify-section-{{ section.id }} {

			--ticker-speed : {{ section.settings.ticker_speed }}s;
		}
	{%- endstyle -%}
	<div
		class="popup-wrap color-{{ section.settings.color_scheme }} background"
		data-introduction-wrapper
		data-popup-ticker-id="{{ section.id }}"
	>
		<button
			type="button"
			class="button modal-close-button popup-close {%- if section.settings.image_layout == "left" %} popup-close_image-left {% endif %} {%- if section.settings.image != blank %} popup-close_image {% endif %}"
			aria-label="{{ 'accessibility.close' | t }}"
		>
			{% if settings.button_animation %}
				<span class="animation-wrapper" hoverstagger="link">
					<span class="button-label animation" hoverstagger="text">
						<span class="word" id="word1">
							{{ 'general.close.title' | t }}
						</span>
					</span>
					<span
						class="button-label is-2 animation"
						hoverstagger="text"
					>
						<span class="word" id="word2">
							{{ 'general.close.title' | t }}
						</span>
					</span>
				</span>
			{% else %}
				<span class="button-label">
					{{ 'general.close.title' | t }}
				</span>
			{% endif %}
		</button>
		<div class="popup-container">
			<div class="popup-outer {%- if section.settings.image != blank %} popup-outer_image {% endif %}">
				{% if section.settings.image != blank %}
					<div class="popup-thumbnail">
						{% capture style %}
            object-fit: {{ section.settings.image_fit }};
          {% endcapture %}
						{{
							section.settings.image
							| image_url: width: section.settings.image.width
							| image_tag:
								loading: 'lazy',
								widths: '275, 550, 750',
								style: style
						}}
						{% if section.settings.ticker_text != blank %}
							<div
								class="popup__ticker-wrapper"
							>
								<div class="marquee">
									<div class="marquee-content">
										{% for i in (1..50) %}
											<div class="marquee-tag">
												<div class="ticker_title">
													<h2 class="ticker_heading h1">
														{{ section.settings.ticker_text }}
													</h2>
												</div>
											</div>
										{% endfor %}
									</div>
								</div>
							</div>
						{% endif %}
					</div>
				{% endif %}

				<div class="popup-content">
					<div
						class="popup-wraper-text"
						style="text-align: {{ section.settings.alignment }}"
					>
						{%- for block in section.blocks -%}
							{%- case block.type -%}
								{%- when 'popup_heading' -%}
									{% if block.settings.heading != blank %}
										<h2
											class="popup-heading h3 {% if "popup_text" != blank %} popup-heading-small {% endif %}"
											{{ block.shopify_attributes }}
										>
											{{ block.settings.heading }}
										</h2>
									{% endif %}
								{% when 'popup_text' %}
									{%- if block.settings.text != blank -%}
										<div class="popup-desc ">{{ block.settings.text }}</div>
									{%- endif -%}
								{%- when 'subscribe_form' -%}
									<div class="popup-newsletter">
										{% form 'customer', class: 'newsletter-form' %}
											<div
												class="newsletter-form__inner {% if section.settings.width < 400 %} newsletter-form__inner_column {% endif %}"
												{{ block.shopify_attributes }}
											>
												{% if block.settings.show_email != blank %}
													<input
														type="hidden"
														name="contact[tags]"
														value="newsletter"
													>
													<div class="newsletter-form__field-wrapper">
														<div class="field">
															<input
																id="NewsletterForm--{{ section.id }}"
																type="email"
																name="contact[email]"
																pattern="[a-z0-9._%+\-]+@[a-z0-9.\-]+\.[a-z]{2,}$"
																class="field__input field"
																value="{{ form.email }}"
																aria-required="true"
																autocorrect="off"
																autocapitalize="off"
																autocomplete="email"
																{% if form.errors %}
																	autofocus
																	aria-invalid="true"
																	aria-describedby="Newsletter-error--{{ section.id }}"
																{% elsif form.posted_successfully? %}
																	aria-describedby="Newsletter-success--{{ section.id }}"
																{% endif %}
																placeholder=" "
																required
															>
															<label
																class="field__label"
																for="NewsletterForm--{{ section.id }}"
																type="hidden"
															>
																{{ block.settings.placeholder_input }}
															</label>
														</div>
														{%- if form.errors -%}
															<small
																class="newsletter-form__message form__message"
																id="Newsletter-error--{{ section.id }}"
															>
																{%- render 'icon-error' -%}
																{{-
																	form.errors.translated_fields.email
																	| capitalize
																}}
																{{ form.errors.messages.email -}}
															</small>
														{%- endif -%}
													</div>
												{% endif %}
												{% comment %}
													<button
														type="submit"
														class="button button--{{ block.settings.button_style }}"
														name="commit"
													>
														<span class="button-label">
															{{- block.settings.button_label -}}
														</span>
													</button>
												{% endcomment %}
												{% if block.settings.button_label != blank %}
													{% if block.settings.button_action == 'accept' %}
														<button class="button button--{{ block.settings.button_style }} popup-button popup-accept">
															{% if settings.button_animation %}
																<span class="animation-wrapper" hoverstagger="link">
																	<span class="button-label animation" hoverstagger="text">
																		<span class="word" id="word1">
																			{{ block.settings.button_label }}
																		</span>
																	</span>
																	<span
																		class="button-label is-2 animation"
																		hoverstagger="text"
																	>
																		<span class="word" id="word2">
																			{{ block.settings.button_label }}
																		</span>
																	</span>
																</span>
															{% else %}
																<span class="button-label">
																	{{ block.settings.button_label }}
																</span>
															{% endif %}
														</button>
													{% else %}
														<a
															class="button button--{{ block.settings.button_style }} popup-button"
															target="_blank"
															{% if block.settings.button_link %}
																href="{{ block.settings.button_link }}"
															{% endif %}
														>
															{% if settings.button_animation %}
																<span class="animation-wrapper" hoverstagger="link">
																	<span class="button-label animation" hoverstagger="text">
																		<span class="word" id="word1">
																			{{ block.settings.button_label }}
																		</span>
																	</span>
																	<span
																		class="button-label is-2 animation"
																		hoverstagger="text"
																	>
																		<span class="word" id="word2">
																			{{ block.settings.button_label }}
																		</span>
																	</span>
																</span>
															{% else %}
																<span class="button-label">
																	{{ block.settings.button_label }}
																</span>
															{% endif %}
														</a>
													{% endif %}
												{% endif %}
											</div>
											{%- if form.posted_successfully? -%}
												<h3
													class="newsletter-form__message newsletter-form__message--success form__message"
													id="Newsletter-success--{{ section.id }}"
													tabindex="-1"
													autofocus
												>
													{% render 'icon-success' -%}
													{{- 'newsletter.success' | t }}
												</h3>
											{%- endif -%}
										{% endform %}
										{% if block.settings.additional_text != blank %}
											<div class="popup-text" {{ block.shopify_attributes }}>
												{{ block.settings.additional_text }}
											</div>
										{% endif %}
									</div>
								{%- when 'social_links' -%}
									{%- if block.settings.show_twitter
										and settings.social_twitter_link != blank
										or block.settings.show_facebook
										and settings.social_facebook_link != blank
										or block.settings.show_pinterest
										and settings.social_pinterest_link != blank
										or block.settings.show_instagram
										and settings.social_instagram_link != blank
										or block.settings.show_tiktok
										and settings.social_tiktok_link != blank
										or block.settings.show_tumblr
										and settings.social_tumblr_link != blank
										or block.settings.show_snapchat
										and settings.social_snapchat_link != blank
										or block.settings.show_youtube
										and settings.social_youtube_link != blank
										or block.settings.show_vimeo
										and settings.social_vimeo_link != blank
										or block.settings.show_linkedin
										and settings.social_linkedin_link != blank
									-%}
										{%- style -%}
											#shopify-section-{{ section.id }}  .popup-main .list-social__item .icon {
											  color: {{ block.settings.icon-color }};
											}
											#shopify-section-{{ section.id }}  .popup-main .list-social__item:hover .icon {
											  color: {{ block.settings.icon-color-hover }};
												opacity: 1;
											}
										{%- endstyle -%}
										<ul
											class="list-unstyled list-social"
											style="justify-content: {{ section.settings.alignment }}"
											role="list"
											{{ block.shopify_attributes }}
										>
											{%- if block.settings.show_twitter
												and settings.social_twitter_link != blank
											-%}
												<li class="list-social__item">
													<a
														href="{{ settings.social_twitter_link }}"
														class="link link--text list-social__link"	
													>
														{%- render 'icon-twitter' -%}
														<span class="visually-hidden">
															{{- 'general.social.links.twitter' | t -}}
														</span>
													</a>
												</li>
											{%- endif -%}
											{%- if block.settings.show_facebook
												and settings.social_facebook_link != blank
											-%}
												<li class="list-social__item">
													<a
														href="{{ settings.social_facebook_link }}"
														class="link link--text list-social__link"
													>
														{%- render 'icon-facebook' -%}
														<span class="visually-hidden">
															{{- 'general.social.links.facebook' | t -}}
														</span>
													</a>
												</li>
											{%- endif -%}
											{%- if block.settings.show_pinterest
												and settings.social_pinterest_link != blank
											-%}
												<li class="list-social__item">
													<a
														href="{{ settings.social_pinterest_link }}"
														class="link link--text list-social__link"
													>
														{%- render 'icon-pinterest' -%}
														<span class="visually-hidden">
															{{- 'general.social.links.pinterest' | t -}}
														</span>
													</a>
												</li>
											{%- endif -%}
											{%- if block.settings.show_instagram
												and settings.social_instagram_link != blank
											-%}
												<li class="list-social__item">
													<a
														href="{{ settings.social_instagram_link }}"
														class="link link--text list-social__link"
													>
														{%- render 'icon-instagram' -%}
														<span class="visually-hidden">
															{{- 'general.social.links.instagram' | t -}}
														</span>
													</a>
												</li>
											{%- endif -%}
											{%- if block.settings.show_tiktok
												and settings.social_tiktok_link != blank
											-%}
												<li class="list-social__item">
													<a
														href="{{ settings.social_tiktok_link }}"
														class="link link--text list-social__link"
													>
														{%- render 'icon-tiktok' -%}
														<span class="visually-hidden">
															{{- 'general.social.links.tiktok' | t -}}
														</span>
													</a>
												</li>
											{%- endif -%}
											{%- if block.settings.show_tumblr
												and settings.social_tumblr_link != blank
											-%}
												<li class="list-social__item">
													<a
														href="{{ settings.social_tumblr_link }}"
														class="link link--text list-social__link"
													>
														{%- render 'icon-tumblr' -%}
														<span class="visually-hidden">
															{{- 'general.social.links.tumblr' | t -}}
														</span>
													</a>
												</li>
											{%- endif -%}
											{%- if block.settings.show_snapchat
												and settings.social_snapchat_link != blank
											-%}
												<li class="list-social__item">
													<a
														href="{{ settings.social_snapchat_link }}"
														class="link link--text list-social__link"
													>
														{%- render 'icon-snapchat' -%}
														<span class="visually-hidden">
															{{- 'general.social.links.snapchat' | t -}}
														</span>
													</a>
												</li>
											{%- endif -%}
											{%- if block.settings.show_youtube
												and settings.social_youtube_link != blank
											-%}
												<li class="list-social__item">
													<a
														href="{{ settings.social_youtube_link }}"
														class="link link--text list-social__link"														
													>
														{%- render 'icon-youtube' -%}
														<span class="visually-hidden">
															{{- 'general.social.links.youtube' | t -}}
														</span>
													</a>
												</li>
											{%- endif -%}
											{%- if block.settings.show_vimeo
												and settings.social_vimeo_link != blank
											-%}
												<li class="list-social__item">
													<a
														href="{{ settings.social_vimeo_link }}"
														class="link link--text list-social__link"
													>
														{%- render 'icon-vimeo' -%}
														<span class="visually-hidden">
															{{- 'general.social.links.vimeo' | t -}}
														</span>
													</a>
												</li>
											{%- endif -%}
											{%- if block.settings.show_linkedin
												and settings.social_linkedin_link != blank
											-%}
												<li class="list-social__item">
													<a
														href="{{ settings.social_linkedin_link }}"
														class="link link--text list-social__link"
													>
														{%- render 'icon-linkedin' -%}
														<span class="visually-hidden">
															{{- 'general.social.links.linkedin' | t -}}
														</span>
													</a>
												</li>
											{%- endif -%}
										</ul>
									{%- endif -%}
									{% comment %}
										{% when 'popup_icon' %}
										{%- if block.settings.icon_item != 'none' -%}
											<div class="popup-icon">
												{%- render 'icon-accordion',
													icon: block.settings.icon_item,
													size: block.settings.icon_size,
													custom_icon: block.settings.custom_icon,
													custom_icon_dark: block.settings.custom_icon_dark
												-%}
											</div>
										{%- endif -%}
									{% endcomment %}
							{% endcase %}
						{% endfor %}
					</div>
				</div>
			</div>
		</div>
	</div>
</div>
{% if section.settings['show-overlay'] %}
	<div
		class="popup-overlay color-inverse"
		style="backdrop-filter: blur(5px);"
	></div>
{% endif %}

{% schema %}
{
	"name": "t:sections.overlay-group.popup.name",
	"enabled_on": {
		"groups": ["custom.overlay"]
	},
	"settings": [
		{
			"type": "color_scheme",
			"id": "color_scheme",
			"default": "background-1",
			"label": "t:sections.all.color_scheme.label"
		},
		{
			"type": "image_picker",
			"id": "image",
			"label": "t:sections.overlay-group.popup.settings.image.label"
		},
		{
			"type": "select",
			"id": "image_layout",
			"label": "t:sections.overlay-group.popup.settings.image_layout.label",
			"options": [
				{
					"value": "left",
					"label": "t:sections.overlay-group.popup.settings.image_layout.options__1.label"
				},
				{
					"value": "right",
					"label": "t:sections.overlay-group.popup.settings.image_layout.options__2.label"
				},
				{
					"value": "top",
					"label": "t:sections.overlay-group.popup.settings.image_layout.options__3.label"
				},
				{
					"value": "bottom",
					"label": "t:sections.overlay-group.popup.settings.image_layout.options__4.label"
				}
			],
			"default": "top"
		},
		{
			"type": "select",
			"id": "image_fit",
			"label": "t:sections.overlay-group.popup.settings.image_fit.label",
			"options": [
				{
					"value": "contain",
					"label": "t:sections.overlay-group.popup.settings.image_fit.options__1.label"
				},
				{
					"value": "cover",
					"label": "t:sections.overlay-group.popup.settings.image_fit.options__2.label"
				}
			],
			"default": "cover"
		},
		{
			"type": "header",
			"content": "t:sections.all.ticker.header.content"
		},
		{
			"type": "text",
			"id": "ticker_text",
			"default": "t:sections.overlay-group.popup.settings.ticker_text.default",
			"label": "t:sections.all.ticker.settings.ticker_text.label",
			"info": "t:sections.all.ticker.info"
		},
		{
			"type": "range",
			"id": "ticker_speed",
			"min": 1,
			"max": 10,
			"step": 0.1,
			"default": 5,
			"unit": "s",
			"label": "t:sections.all.ticker.settings.ticker_speed.label"
		},
		{
			"type": "text_alignment",
			"id": "alignment",
			"label": "t:sections.all.content_alignment.label",
			"default": "center"
		},
		{
			"type": "range",
			"id": "limit-display",
			"min": 0,
			"max": 100,
			"default": 0,
			"label": "t:sections.overlay-group.all.settings.limit-display.label",
			"info": "t:sections.overlay-group.all.settings.limit-display.info"
		},
		{
			"type": "number",
			"id": "limit-cache",
			"default": 30,
			"label": "t:sections.overlay-group.all.settings.limit-cache.label"
		},
		{
			"type": "select",
			"id": "position",
			"options": [
				{
					"value": "top-left",
					"label": "t:sections.overlay-group.all.settings.position.options__1.label"
				},
				{
					"value": "top",
					"label": "t:sections.overlay-group.all.settings.position.options__2.label"
				},
				{
					"value": "top-right",
					"label": "t:sections.overlay-group.all.settings.position.options__3.label"
				},
				{
					"value": "left",
					"label": "t:sections.overlay-group.all.settings.position.options__4.label"
				},
				{
					"value": "center",
					"label": "t:sections.overlay-group.all.settings.position.options__5.label"
				},
				{
					"value": "right",
					"label": "t:sections.overlay-group.all.settings.position.options__6.label"
				},
				{
					"value": "bottom-left",
					"label": "t:sections.overlay-group.all.settings.position.options__7.label"
				},
				{
					"value": "bottom",
					"label": "t:sections.overlay-group.all.settings.position.options__8.label"
				},
				{
					"value": "bottom-right",
					"label": "t:sections.overlay-group.all.settings.position.options__9.label"
				}
			],
			"default": "center",
			"label": "t:sections.overlay-group.all.settings.position.label"
		},
		{
			"type": "checkbox",
			"id": "full-height",
			"default": false,
			"label": "t:sections.overlay-group.all.settings.layout.label"
		},
		{
			"type": "header",
			"content": "t:sections.overlay-group.all.settings.trigger.header.content"
		},
		{
			"type": "text",
			"id": "popup-id",
			"label": "t:sections.overlay-group.all.settings.popup-id.label"
		},
		{
			"type": "select",
			"id": "trigger-open",
			"label": "t:sections.overlay-group.all.settings.trigger-open.label",
			"options": [
				{
					"value": "delay",
					"label": "t:sections.overlay-group.all.settings.trigger.options__1.label"
